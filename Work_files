fasm lab_1.asm lab_1
chmod +x lab_1
./lab_1
gcc -o C_version C_version.c
./C_version
gdb -batch -ex "file lab_1" -ex "starti" -ex "disassemble /r \$pc,\$pc+100" > Disassemble
gdb -batch -ex "file C_version" -ex "starti" -ex "disassemble /r \$pc,\$pc+100" >> Disassemble
mkdir sandbox
mv lab_1.asm lab_1 C_version.c C_version Disassemble sandbox/

